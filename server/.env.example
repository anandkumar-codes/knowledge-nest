# SQLite database file (relative to the server folder). Created automatically.
# Used when TURSO_DATABASE_URL is empty (e.g. on your PC).
DATABASE_PATH=./data/knowledge-nest.db

# Turso cloud database (used when hosted, e.g. on Render). When set, DATABASE_PATH is ignored.
#   TURSO_DATABASE_URL=libsql://your-database-name.turso.io
# The token is also used by `npm run copy-db` and `npm run backup` to reach Turso from your PC.
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=

# Long random string — generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change-me

PORT=5000
CLIENT_ORIGIN=http://localhost:5173

# The reading room's time zone. "Today", bookings, dues and reports follow it,
# wherever the server runs (cloud servers usually run on UTC).
APP_TIMEZONE=Asia/Kolkata

# Set ONLY when the API runs behind a reverse proxy (nginx, Caddy, a cloud load balancer):
# the number of proxies in front of it, usually 1. Leave empty when the API is reached directly,
# otherwise anyone can fake their address and get around the sign-in attempt limits.
TRUST_PROXY=

# Set to false ONLY when visitors' real addresses are hidden (e.g. Tailscale Funnel, where everyone arrives
# from the same address). Sign-ins are then limited per account only, so one busy hour can't lock out everyone.
SIGNIN_LIMIT_BY_ADDRESS=

# Daily database backups (the server takes one a day; `npm run backup` takes one now).
# Point BACKUP_DIR at another drive or a synced folder (OneDrive / Google Drive) to survive a disk failure.
BACKUP_DIR=./data/backups
BACKUP_KEEP=30

# Used once by `npm run seed` to create the super admin account
SUPERADMIN_NAME=Super Admin
SUPERADMIN_EMAIL=owner@knowledgenest.in
SUPERADMIN_PASSWORD=
